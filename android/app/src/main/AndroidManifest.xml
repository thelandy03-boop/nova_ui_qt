<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.novastudio.nova">

    <!-- Permisos de audio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 🔒 El permiso que corresponde al tipo "mediaPlayback" del servicio en
         primer plano. En Android 14+ (targetSdk 35) llamar a startForeground()
         con un tipo cuyo permiso no esta declarado es un SecurityException que
         mata el proceso: por eso va aqui, y no solo FOREGROUND_SERVICE. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 🔒 FOREGROUND_SERVICE_MICROPHONE no va aqui (todavia): solo hace falta
         si el servicio declara el tipo "microphone", y ese tipo se anade el dia
         que haya grabador. Declararlo antes seria anunciar una capacidad que
         la app no usa (la Device and Network Abuse policy de Play pide que el
         audio lo inicie el usuario). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Almacenamiento (Scoped Storage Android 10+) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" 
        tools:ignore="ScopedStorage" />
    
    <!-- MIDI USB/Bluetooth -->
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Features -->
    <uses-feature android:name="android.hardware.audio.low_latency" android:required="true" />
    <uses-feature android:name="android.hardware.audio.pro" android:required="false" />
    <uses-feature android:name="android.hardware.midi" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name=".NovaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaStudio"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NovaStudio.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- Handle file opening -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.ardour" />
                <data android:pathPattern=".*\\.nova" />
            </intent-filter>

            <!-- 🔒 El nombre de la librería nativa principal. QtLoader lo lee
                 del manifest (getMetaData("android.app.lib_name")) y le añade
                 el ABI del dispositivo: carga libnova_ui_qt_arm64-v8a.so en un
                 telefono de 64 bits. El valor va SIN el sufijo del ABI.
                 Sin esto, Qt no encuentra la librería y la app se cierra al
                 abrirla ("Loading main library failed"). -->
            <meta-data android:name="android.app.lib_name" android:value="nova_ui_qt" />
        </activity>

        <!-- Foreground Service for audio recording/playback -->
        <!-- 🔒 El tipo es solo "mediaPlayback": es el que no necesita permisos y
             el que no obliga a que el usuario inicie el audio. El tipo
             "microphone" se añade (aquí y en el permiso) el día que haya
             grabador; hasta entonces, el servicio solo reproduce. -->
        <service
            android:name=".AudioForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />

        <!-- USB MIDI Device Permission -->
        <meta-data
            android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
            android:resource="@xml/usb_device_filter" />

        <!-- Audio Policy -->
        <meta-data
            android:name="android.media.AUDIO_POLICY_CONFIGURATION"
            android:resource="@xml/audio_policy" />

    </application>

    <queries>
        <!-- For USB MIDI -->
        <intent>
            <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
        </intent>
    </queries>

</manifest>