<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="files" path="."/>
        <exclude domain="files" path="cache/"/>
        <exclude domain="files" path="tmp/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="files" path="."/>
        <exclude domain="files" path="cache/"/>
        <exclude domain="files" path="tmp/"/>
    </device-transfer>
</data-extraction-rules>